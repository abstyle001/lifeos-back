# 复制本文件为 .env 并按需修改。pydantic-settings 会自动读取 back/.env。

# PostgreSQL 连接串（SQLAlchemy 格式，psycopg 驱动）
DATABASE_URL=postgresql+psycopg://lifeos:lifeos@localhost:5432/lifeos
#DATABASE_URL=postgresql+psycopg://postgres.hpvswbalvbqwonojbwvo:STYHzIP4OIXeX6gV@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# JWT 签名密钥：生产环境务必改成随机长字符串
SECRET_KEY=change-me-to-a-random-string

# 允许跨域的前端来源（JSON 数组格式）
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# 首次启动是否写入演示数据（demo/demo1234）；生产设为 false
SEED_DEMO=true

# 启动时是否自动建表（create_all）。生产可设为 false，并预先用 `uv run init-db` 一次性建表
AUTO_CREATE_TABLES=true

# AI 教练（OpenAI 兼容接口：DeepSeek / Qwen / Kimi / GLM / OpenAI / Ollama）
# AI_BASE_URL 或 AI_MODEL 留空时，周报自动退化为内置离线分析（不会报错）
# DeepSeek 示例：AI_BASE_URL=https://api.deepseek.com/v1  AI_MODEL=deepseek-chat
# Ollama 示例：AI_BASE_URL=http://localhost:11434/v1  AI_MODEL=llama3.1（AI_API_KEY 留空）
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=20
